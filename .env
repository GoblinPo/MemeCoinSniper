# Rename this file to ".env"

# ---- required ----
DISCORD_TOKEN=your_bot_token
ALERT_CHANNEL_ID=123456789012345678

# ---- optional ----
WARNING_CHANNEL_ID=           # rug warnings (defaults to the alert channel)
GUILD_ID=                     # your server ID = slash commands appear instantly

# ---- what counts as a NEW coin ----
MAX_PAIR_AGE_MINUTES=30

# ---- spike detection (defaults shown) ----
SPIKE_WINDOW_SECONDS=60       # volume + buy/sell window
PRICE_WINDOW_SECONDS=120      # price-jump window
MIN_SPIKE_VOLUME_USD=1000     # $ that must trade inside the window
MAX_GAIN_SINCE_LAUNCH_PCT=400 # skip coins that already ran this far

# ---- basic quality filters ----
MIN_LIQUIDITY_USD=5000
MIN_TOTAL_TXNS=25
MIN_TOTAL_VOLUME_USD=2000

# ---- alerting ----
ALERT_SCORE_THRESHOLD=60
STRONG_SCORE_THRESHOLD=80
ALERT_COOLDOWN_SECONDS=1200
SCAN_INTERVAL_SECONDS=20
CHAINS=solana,base,ethereum,bsc
STRICT_SECURITY=false         # true = any security warning blocks the alert
REQUIRE_SECURITY_CHECK=false  # true = coins that can't be verified are blocked
DATA_DIR=.
